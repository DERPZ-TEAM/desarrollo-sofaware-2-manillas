# ===========================================================================
# Copia este archivo como  proyecto/.env  y cambia los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ===========================================================================

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Base de datos ---
# Opción A: PostgreSQL local (el mismo que ves en pgAdmin)
DB_NAME=goldbracelets
DB_USER=postgres
DB_PASSWORD=tu_clave_de_postgres
DB_HOST=localhost
DB_PORT=5432
# Opción B: una URL completa (tiene prioridad sobre DB_*). Ej. Supabase:
# DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Imágenes en Supabase Storage (opcional en local) ---
# Si las dejas vacías, las imágenes se guardan en proyecto/media/
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=imagenes-productos

# --- Frontend (para el enlace de recuperar contraseña) ---
FRONTEND_URL=http://localhost:5173
