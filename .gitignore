# Entornos virtuales de Python
.venv/
proyecdjango/

# Secretos y configuración local (NUNCA subir)
proyecto/.env
proyecto/.env.*
!proyecto/.env.example

# Base de datos local y archivos subidos
proyecto/db.sqlite3
proyecto/media/

# Archivos generados
proyecto/staticfiles/
__pycache__/
*.py[cod]

# Respaldos y datos de prueba
proyecto/respaldo*.json
proyecto/*_importar.json
proyecto/usuarios_prueba.json
proyecto/perfiles_carritos.json

# Configuración local del editor
.claude/launch.json
.vscode/
